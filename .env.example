# --- Supabase ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# ¡Solo servidor! Nunca la expongas con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Bucket privado donde viven los audios (lo crea la migración)
SUPABASE_AUDIO_BUCKET=relatos

# --- Admin ---
# Único email con acceso a /admin (debe existir como usuario en Supabase Auth)
ADMIN_EMAIL=vos@ejemplo.com

# --- App ---
# URL pública (se usa para el link mágico de login del admin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fecha del puzzle #1 (YYYY-MM-DD, hora de Buenos Aires)
NEXT_PUBLIC_LAUNCH_DATE=2026-01-01
# Tapar el video de YouTube mientras se juega (true/false). Ojo: las políticas
# de YouTube prohíben ocultar el reproductor; si hay problemas, poné false.
NEXT_PUBLIC_OCULTAR_VIDEO=true
